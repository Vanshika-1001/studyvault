# ==============================================================================
# StudyVault Environment Configuration Guide
# Copy this file to .env in /server (and /client if needed)
# DO NOT commit real secrets or production credentials to GitHub!
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://localhost:27017/studyvault
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/studyvault?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/studyvault

# JWT Secret & Expiration
JWT_SECRET=studyvault_super_secret_jwt_key_development_only_change_in_production
JWT_EXPIRE=30d

# Client URL (For CORS configuration)
CLIENT_URL=http://localhost:5173

# Optional: Initial Admin Seed Credentials
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@studyvault.edu
ADMIN_PASSWORD=Admin@12345
